{
  "id": "stat-reveal",
  "label": "Stat Reveal",
  "category": "data-viz",
  "tags": ["stat", "number", "metric", "data-viz", "kpi"],
  "bestFor": ["headline metric", "growth number", "single KPI reveal"],
  "aspectRatios": ["16:9", "9:16", "1:1"],
  "fps": 30,
  "durationBoundsSec": { "min": 3, "max": 8 },
