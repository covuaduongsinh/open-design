  "durationSec": 5,
  "width": 1920,
  "height": 1080,
  "inputs": {
    "value": { "label": "Big value", "default": "+40%", "kind": "text" },
    "label": { "label": "Label", "default": "Revenue growth", "kind": "text" },
    "caption": { "label": "Caption", "default": "", "kind": "text" },
    "accent": { "label": "Accent color", "default": "#5ee0a0", "kind": "color" },
    "background": { "label": "Background color", "default": "#0b0e14", "kind": "color" }
  }
}
